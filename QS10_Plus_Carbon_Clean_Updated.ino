    String jsonSendContent ;
    // Append new data
    jsonSendContent += "[";
    jsonSendContent += id;
    jsonSendContent += ",";
    jsonSendContent += time;
    jsonSendContent += ",";
    jsonSendContent += size;
    jsonSendContent += "]";
    jsonSendContent += ",";
    if (!LittleFS.begin()) { 
        Serial.println("Failed to mount file system");
        return;
    }

    // Check if file exists
    bool fileExists = LittleFS.exists(LOG_FILE_PATH);

    File file;
    if (fileExists) {
        file = LittleFS.open(LOG_FILE_PATH, "a"); // Open file for reading & writing
    } else {
        file = LittleFS.open(LOG_FILE_PATH, "w");  // Create new file
        file.print("[");
    }

    if (!file) {
        Serial.println("Failed to open file");
        return;
    }
    file.print(jsonSendContent);
    delay(5);
    
    file.close();
     

    Serial.println("Data appended successfully!");
}
