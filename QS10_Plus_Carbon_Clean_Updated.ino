void loop() {
  
  MDNS.update();
  ws.cleanupClients();
   // Serial.listen();

  while (Serial.available()) {
    start = Serial.find('*');
    if (start) {

      temp1_buf  = Serial.parseFloat();
      temp2_buf  = Serial.parseFloat();
      p1_buf     = Serial.parseInt();
      level_buf = Serial.parseInt();
      level_2_buf = Serial.parseInt();
      p2_buf     = Serial.parseInt();
      current_buf = Serial.parseInt();
      leak_buf   = Serial.parseInt();
      start_led_buf   = Serial.parseInt(); 
      temp3_buf  = Serial.parseFloat();
      CRC        = Serial.parseInt();
      CRC_buf    = (1 * (int)temp1_buf) +(2 * (int)temp2_buf) + (3 * p1_buf) + (4 * level_buf)+ (5 * level_2_buf)+ (6 * p2_buf) + (7 * current_buf) +(8 * leak_buf)+(9*start_led_buf)+(10*(int)temp3_buf);
      Serial.flush();
      
      break ;
    }
    Serial.flush();
  }

  if (CRC == CRC_buf) {
    temperature1 = round(temp1_buf * 100) / 100.0;
    temperature2 = round(temp2_buf * 100) / 100.0;
    temperature3 = round(temp3_buf * 100) / 100.0;
    pressure     = p1_buf;
    current = current_buf ;
     level_1 = level_buf;
    flash = flash_buf;
    leak  = leak_buf;
    level_2 =level_2_buf;
    start_led = start_led_buf ;
    CRC     = 0 ;
    CRC_buf = 1 ;
    serial_con_status = 0 ;
  }

   if(timer<1){
  ledState=0;
  notifyClients();
  }
   if ((millis() - lastTime_control) > timerDelay_control) {
