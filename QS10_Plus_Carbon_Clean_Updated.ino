        updateElement("timer", data.timer);
      }
    };
    xhttp.open("GET", endpoint, true);
    xhttp.send();
  }, interval);
}

function updateElement(elementId, value, colorCallback) {
  var element = document.getElementById(elementId);
  element.innerHTML = value;
  if (colorCallback) {
    colorCallback(element, parseFloat(value));
  }
}
function setColorBasedOnPressure(element, pressure) {
  if (pressure > 9) {
    element.style.color = 'red';
  } else if (pressure > 5) {
    element.style.color = 'yellow';
  } else if (pressure > -2){
    element.style.color = 'green';
  }else {
    element.style.color = 'red';
  }
}
function setColorBasedOnTemperature(element, temperature) {
  if (temperature > 60) {
    element.style.color = 'red';
  } else if (temperature > 50) {
    element.style.color = 'yellow';
  } else if (temperature > -20) {
    element.style.color = 'green';
  } else {
    element.style.color = 'red';
  }
}

function setColorBasedOnLevel(element, level) {
  if (level > 89) {
    element.style.color = 'red';
  } else if (level > 80) {
    element.style.color = 'yellow';
  } else if (level > 15) {
    element.style.color = 'green';
  } else if (level > 5) {
    element.style.color = 'yellow';
  } else {
    element.style.color = 'red';
  }
}

