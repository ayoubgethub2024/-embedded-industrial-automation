void readFile(const char *path) {
  Serial.printf("R FS: %s\n", path);

  File file = LittleFS.open(path, "r");
  if (!file) {
    Serial.println("Failed");
    return;
  }
  outdata="";
  while (file.available()) { outdata = file.readString(); }
  file.close();
}

void writeFile(const char *path, const char *message) {

  File file = LittleFS.open(path, "w");
  if (!file) {
    return;
  }
  if (file.print(message)) {
  } else {
  }
  delay(5);  // Make sure the CREATE and LASTWRITE times are different
  file.close();
}

