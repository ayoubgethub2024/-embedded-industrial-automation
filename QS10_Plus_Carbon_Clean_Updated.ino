        updateElement("pressure", data.pressure, setColorBasedOnPressure);
        updateElement("level1", data.level1, setColorBasedOnLevel);
        updateElement("level2", data.level2, setColorBasedOnLevel);
        updateElement("timerh", data.time_hours);
        updateElement("timerm", data.time_minutes);
        updateElement("error_code", data.error_code);
        updateElement("IP", data.IP);
        updateElement("ID", data.ID);
        updateElement("max_heap", data.max);
        updateElement("free_heap", data.free);
        updateElement("frag_heap", data.frag);
