    jsonDoc["IP"]   = locked;
    jsonDoc["ID"]   = locked;
  }

  // Add error code to the JSON object
  jsonDoc["error_code"] = error_code;

  // Serialize the JSON object to a string
  String WSResponse;
  serializeJson(jsonDoc, WSResponse);
      ws.textAll(WSResponse);
    }
   
    if (serial_con_status>30) {
    temperature1  = -99 ;
    temperature2  = -99 ;
    temperature3  = -99 ;
    pressure     = -99;
    current = -99 ;
    level_1 = -99;
    flash = -99;
    leak  = -99;
    level_2 =-99;
  }
   error_code = esp_leak;

  if((millis() - lastTime_counter) > timerDelay_counter){
      powered_sec_dif = (millis() - lastTime_counter)/1000.0 ;
      powered_sec_counter = powered_sec_counter + (powered_sec_dif) ;
      if (powered_sec_counter >= 60) {
        powered_sec_counter = powered_sec_counter - 60;
        powered_min_counter = powered_min_counter + 1;
      }
      if (powered_min_counter >= 60) {
        powered_min_counter = powered_min_counter - 60;
        powered_hrs_counter = powered_hrs_counter + 1;
