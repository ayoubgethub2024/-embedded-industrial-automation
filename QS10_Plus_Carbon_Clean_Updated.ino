  if (service_mode) {
    jsonDoc["free"] = heapfree;
    jsonDoc["max"]  = heapmax;
    jsonDoc["frag"] = heapfrag;
    jsonDoc["on_hrs"] = powered_hrs_counter_s;
    jsonDoc["on_min"] = powered_min_counter_s;
