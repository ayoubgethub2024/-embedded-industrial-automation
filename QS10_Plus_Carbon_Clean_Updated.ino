void notifyClients() {
  ws.textAll(String(ledState));
}

void handleWebSocketMessage(void *arg, uint8_t *data, size_t len) {
  AwsFrameInfo *info = (AwsFrameInfo*)arg;
  if (info->final && info->index == 0 && info->len == len && info->opcode == WS_TEXT) {
    data[len] = 0;
    if (strcmp((char*)data, "toggle") == 0) {
      ledState = !ledState;
      notifyClients();
    }
    if (strcmp((char*)data, "stop") == 0) {
      ledState = 0;
      
      notifyClients();
            Serial.println(" stop");

    }
    if (strcmp((char*)data, "start") == 0) {
      ledState = 1;
       
      notifyClients();
                  Serial.println(" start");

    }
    if (strcmp((char*)data, "ota") == 0) {
      ledState = 0;
      notifyClients();
      ota = service_mode ; 
    }
    if (strcmp((char*)data, "calibrate") == 0) {
      if(service_mode){
      Last_calibration_min = powered_min_counter ;
      Last_calibration_hrs = powered_hrs_counter ;
      Last_calibration_min_s = String(Last_calibration_min);
      Last_calibration_hrs_s = String(Last_calibration_hrs);
      writeFile("/cal_hrs.txt", (String(Last_calibration_hrs_s)).c_str());
      writeFile("/cal_min.txt", (String(Last_calibration_min_s)).c_str());
      writeFile(LOG_FILE_PATH,"[");  
    }}
    if (strcmp((char*)data, "1000") == 0) {
      engine_size = 1000;
      Serial.println("engine_size 1000");
    }else if (strcmp((char*)data, "2000") == 0) {
      engine_size = 2000;
      Serial.println("engine_size 2000");
    }else if (strcmp((char*)data, "3000") == 0) {
      engine_size = 3000;
      Serial.println("engine_size 3000");
    }else if (strcmp((char*)data, "4000") == 0) {
      engine_size = 4000;
      Serial.println("engine_size 4000");
    }else if (strcmp((char*)data, "t30") == 0) {
      clean_time = 30;
      timer =30;
      Serial.println("timer t30");
    }else if (strcmp((char*)data, "t45") == 0) {
      clean_time = 45;
      timer =45;
      Serial.println("timer t45");
    }else if (strcmp((char*)data, "t60") == 0) {
      clean_time = 60;
      timer =60;
      Serial.println("timer t60");
    }
  }
}

void onEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type,
             void *arg, uint8_t *data, size_t len) {
    switch (type) {
      case WS_EVT_CONNECT:
        Serial.printf("WebSocket client #%u connected from %s\n", client->id(), client->remoteIP().toString().c_str());
        notifyClients();
        break;
      case WS_EVT_DISCONNECT:
        Serial.printf("WebSocket client #%u disconnected\n", client->id());
        service_mode = 0;
        break;
      case WS_EVT_DATA:
        handleWebSocketMessage(arg, data, len);
        break;
      case WS_EVT_PONG:
      case WS_EVT_ERROR:
        break;
        
  }
}

void initWebSocket() {
  ws.onEvent(onEvent);
  server.addHandler(&ws);
}

String processor(const String& var){
  Serial.println(var);
  if(var == "STATE"){
    if (ledState){
      return "ON";
    }
    else{
      return "OFF";
    }
  }return "";}

void notFound(AsyncWebServerRequest *request)
{
  request->send(404, "text/plain", "404");
}

